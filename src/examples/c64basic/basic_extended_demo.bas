10 REM C64 BASIC COMPILER - ERWEITERTE KOMPONENTEN
20 DIM F(3),I%(2,2),S$(2)
30 X=1.5:Y=2.25:Z=X*Y+0.5
40 F(1)=Z:I%(1,2)=42:S$(1)="HELLO"+" C64"
50 DATA 3.14,"DATA TEXT",7
60 READ R,T$,J%
70 PRINT "FLOAT:";Z,"ARRAY:";F(1),I%(1,2)
80 PRINT "STRING:";S$(1),"DATA:";R,T$,J%
90 INPUT "NAME";N$
100 INPUT "WERT";V
110 GET K$
120 PRINT "EINGABE:";N$,V,K$
130 OPEN 2,8,2,"BASICDEMO,S,W"
140 PRINT#2,N$;",";V
150 CLOSE 2
160 RESTORE 50
170 READ R2
180 PRINT "RESTORE:";R2
190 END
