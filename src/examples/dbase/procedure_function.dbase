// ---------------------------------------------------------------------------
// dBase Stage 7: PROCEDURE / FUNCTION
// ---------------------------------------------------------------------------

function add(a, b)
    return a + b

function label(value)
    return "Wert = " + value

function identity(value)
    return value

procedure show(a, b)
    ? "Procedure: " + (a + b)
    return

? "add(2, 3) = " + add(2, 3)
? label(14)
? identity("String Return")
? identity('A')

show(10, 20)
