    function __main__
        return 7

    procedure TestAndNotXor
        IF A > 0 .AND. C < 10
            ? "Beide Bedingungen erfüllt"
        ELSE
            ? "Bedingung nicht erfüllt"
        ENDIF
        IF .NOT. (A = 0 .OR. C >= 10)
            ? "NOT und OR funktionieren"
        ENDIF
        IF (A > 0) .XOR. (C < 0)
            ? "Genau eine Bedingung ist wahr"
        ENDIF
    return

    procedure PushButton1_onClick(Sender)
        STORE 101.42 TO Ausdruck
        Ausdruck = 101.42
        ? Ausdruck
        STORE INT(Ausdruck) TO Ausdruck
        ? Ausdruck
        ? "1: " + 101.42
        ? "2: " + INT(101.42)
        ? "3: " + Ausdruck
        STORE "Zeichenstring" TO SpeicherVar
        ? "4: " + SpeicherVar
        ? "5: " + !($(SpeicherVar, 8, 6))
        TestAndNotXor()

        STORE ismouse() TO HatMaus
        IF HatMaus = 1
            ? "Eine Maus ist vorhanden."
        ELSE
            ? "Keine Maus erkannt."
        ENDIF
        IF ismouse() .AND. HatMaus = 1
            ? "Maus kann verwendet werden."
        ENDIF
        ? ismouse()
        

        STORE iskeyboard() TO HatTastatur
        IF HatTastatur = 1
            ? "Eine Tastatur ist vorhanden."
        ELSE
            ? "Keine Tastatur erkannt."
        ENDIF
        IF iskeyboard() .AND. ismouse()
            ? "Maus und Tastatur sind vorhanden."
        ENDIF
        IF .NOT. iskeyboard()
            ? "Keine Tastatur gefunden."
        ENDIF
        ? iskeyboard()
        

        STORE 'A' TO Zeichen
        IF ISUPPER(Zeichen)
            ? "Grossbuchstabe erkannt"
        ENDIF
        IF CheckLower('z')
            ? "Kleinbuchstabe erkannt"
        ENDIF

        ? LEN("Ein String")
        ** Ergebnis: 10
        
        STORE "   Hallo Welt   " TO Text
        
        ? LEN(Text)
        ** Ergebnis: 16
        
        ? "[" + LTRIM(Text) + "]"
        ** Ergebnis: [Hallo Welt   ]
        
        ? "[" + TRIM(Text) + "]"
        ** Ergebnis: [Hallo Welt]

        STORE TRIM(Text) TO Ergebnis
        ? LEN(Ergebnis)
        ** Ergebnis: 10
    return

    FUNCTION CheckLower(c)
    RETURN ISLOWER(c)

