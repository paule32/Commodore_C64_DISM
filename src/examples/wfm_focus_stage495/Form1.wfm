CLASS Form1 OF FORM
    THIS.Caption = "Qt5-Fokusereignisse Windows / Linux"
    THIS.Width = 480
    THIS.Height = 200

    THIS.PushButton1 = NEW BUTTON()
    THIS.PushButton1.Left = 20
    THIS.PushButton1.Top = 30
    THIS.PushButton1.Width = 200
    THIS.PushButton1.Height = 35
    THIS.PushButton1.Text = "Erster Button"
    THIS.PushButton1.OnGotFocus = CLASS::PushButton1_onGotFocus
    THIS.PushButton1.OnLostFocus = CLASS::PushButton1_onLostFocus
    THIS.PushButton1.OnClick = CLASS::PushButton1_onClick

    THIS.PushButton2 = NEW BUTTON()
    THIS.PushButton2.Left = 20
    THIS.PushButton2.Top = 90
    THIS.PushButton2.Width = 200
    THIS.PushButton2.Height = 35
    THIS.PushButton2.Text = "Zweiter Button"

    PROCEDURE PushButton1_onGotFocus(Sender)
        ? "PushButton1 hat den Fokus erhalten"
        RETURN

    PROCEDURE PushButton1_onLostFocus(Sender)
        ? "PushButton1 hat den Fokus verloren"
        RETURN

    PROCEDURE PushButton1_onClick(Sender)
        ? "PushButton1 wurde angeklickt"
        RETURN
ENDCLASS
