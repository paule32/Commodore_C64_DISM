<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <remove name="PHP Scripting" />
            <add name="PHP Scripting" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="T:\Programme\PHP_8_5_5\php-cgi.exe" resourceType="File" requireAccess="Script" />
        </handlers>
    </system.webServer>
</configuration>
